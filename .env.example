# Copiez ce fichier en .env puis adaptez les valeurs.
# Clé secrète Flask (obligatoire en production) :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# development | production | testing
FLASK_CONFIG=development

# Adresse d'écoute du serveur de développement (lue par `flask run` et `python run.py`)
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# Adresse publique (liens des e-mails ; évite de dépendre de l'en-tête Host)
# APP_BASE_URL=https://voyages.example.org
# Nombre de proxys inverses de confiance (nginx, Caddy…) : active ProxyFix
# PROXY_FIX_COUNT=1

# Limitation de débit. memory:// est propre à chaque processus : avec plusieurs workers,
# utilisez un stockage partagé, par exemple redis://localhost:6379
# RATELIMIT_STORAGE_URI=memory://
# LOGIN_RATE_LIMIT=5 per minute;30 per hour
# REGISTER_RATE_LIMIT=10 per hour
# PASSWORD_RESET_RATE_LIMIT=5 per hour

# HSTS (envoyé uniquement en HTTPS ; 1 an par défaut en production, 0 pour désactiver)
# HSTS_MAX_AGE=31536000

# E-mails (réinitialisation du mot de passe). Sans MAIL_SERVER, la fonction est désactivée
# en production ; en développement, le lien est écrit dans les logs.
# MAIL_SERVER=smtp.example.org
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USE_SSL=0
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=Carnet de voyages <no-reply@example.org>
# PASSWORD_RESET_MAX_AGE=3600
# Validité du lien magique d'inscription (secondes)
# SIGNUP_LINK_MAX_AGE=900

# Import de voyages par e-mail : boîte IMAP relevée par cron (flask mail-import, voir README).
# Les utilisateurs y transfèrent leurs confirmations ; sans IMAP_SERVER, l'import est désactivé.
# IMAP_SERVER=imap.example.org
# IMAP_PORT=993
# IMAP_USERNAME=import@example.org
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# IMPORT_ADDRESS=import@example.org
# MAIL_IMPORT_REQUIRE_DKIM=1
# MAIL_IMPORT_ERROR_EMAIL=import-error@example.invalid

# Journalisation et suivi des erreurs (Sentry facultatif : pip install "sentry-sdk[flask]")
# LOG_LEVEL=INFO
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# Photos : dossier de stockage (vide : instance/uploads), taille maximale par photo et par requête,
# nombre maximal de photos par trajet ou voyage
# UPLOAD_FOLDER=
# MAX_PHOTO_MB=15
# MAX_UPLOAD_MB=64
# MAX_PHOTOS_PER_ITEM=30

# Sauvegardes (flask backup create) : dossier et nombre d'archives conservées
# BACKUP_DIR=
# BACKUP_KEEP=14

# Base de données (SQLite par défaut dans instance/travel.db)
# DATABASE_URL=sqlite:////chemin/absolu/travel.db

# Géocodage Nominatim — un User-Agent identifiant votre application est obligatoire
# (https://operations.osmfoundation.org/policies/nominatim/)
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=TravelMap/1.0 (https://example.org; contact@example.org)
# Adresse de contact optionnelle transmise via le paramètre email=
NOMINATIM_EMAIL=
# Intervalle minimal entre deux requêtes (secondes)
NOMINATIM_MIN_INTERVAL=1.0
# Fichier verrou partagé par les workers d'une même machine (vide : instance/nominatim.lock)
# NOMINATIM_LOCK_FILE=
# Distances routières par un serveur OSRM (facultatif ; sinon distance estimée par mode).
# Le serveur de démonstration ne calcule que la voiture et n'accepte pas d'usage intensif.
# ROUTING_URL=https://router.project-osrm.org
# ROUTING_PROFILES=car:driving,bus:driving
# Durée de validité du cache de géocodage (jours)
GEOCODE_CACHE_DAYS=30
# Itinéraire d'un numéro de vol (adsbdb, gratuit, sans clé) ; vide pour désactiver.
# FLIGHT_LOOKUP_URL=https://api.adsbdb.com/v0/callsign/
# FLIGHT_LOOKUP_TIMEOUT=8

# Fond de carte (par défaut : tuiles OpenStreetMap, mode sombre par filtre CSS).
# Respectez la politique d'usage : https://operations.osmfoundation.org/policies/tiles/
# Pour un fournisseur avec tuiles claires/sombres (CARTO, Stadia, MapTiler… souvent avec clé) :
# MAP_TILE_URL=https://{s}.example.com/light/{z}/{x}/{y}{r}.png?key=VOTRE_CLE
# MAP_TILE_URL_DARK=https://{s}.example.com/dark/{z}/{x}/{y}{r}.png?key=VOTRE_CLE
# MAP_TILE_SUBDOMAINS=abcd
# Attribution supplémentaire du fournisseur (HTML), ajoutée après celle d'OpenStreetMap :
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://carto.com/attributions">CARTO</a>
MAP_TILE_MAX_ZOOM=19

# Logos des compagnies et opérateurs sur /stats/plane et /stats/train : clé publiable logo.dev (pk_…),
# chargée par le navigateur. Restreignez-la à votre domaine dans le tableau de bord logo.dev.
# LOGO_DEV_TOKEN=pk_...
